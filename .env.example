# Copie para .env.local e ajuste. Em producao, as mesmas chaves entram como
# variaveis de ambiente na Vercel.

# Em desenvolvimento o Vite faz proxy de /api para http://localhost:3000.
# Em producao aponte para https://api.travion.com.br/api
VITE_API_BASE_URL=/api

# Somente digitos: 55 + DDD + numero. Usado no link wa.me do CTA de resultado.
VITE_WHATSAPP_NUMBER=5512997643952

VITE_PUBLIC_APP_URL=http://localhost:5173

# Vazios por ora: o dataLayer ja dispara os eventos, os IDs entram quando existirem.
VITE_GTM_ID=
VITE_META_PIXEL_ID=
